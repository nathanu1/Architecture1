# Copy to .env or export in your shell. Never commit real values.
# `ga` reads credentials from the environment only.

# Anthropic (Claude) generation
ANTHROPIC_API_KEY=

# Optional: OpenAI generation and/or embeddings
OPENAI_API_KEY=

# Optional: a local sentence-transformers model directory, used without any download at run time
GA_LOCAL_EMBEDDING_MODEL_DIR=

# Optional: Llama (or any model) through a hosted OpenAI-compatible API (configs/town_llama_api.yaml)
LLAMA_API_KEY=

# Optional: password for the town and viewer when served to a network (docs/deploy.md);
# HEARTHSIDE_SPECTATORS=1 lets anyone watch while the password is needed to act
HEARTHSIDE_PASSWORD=
HEARTHSIDE_SPECTATORS=

# Optional: the model server of the living town when it is not this machine (ga town, ga bench).
# An Ollama address such as http://gpu-box:11434, or an OpenAI-compatible one ending in /v1.
HEARTHSIDE_LLM_URL=
